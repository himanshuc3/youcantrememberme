# Copy to `.env` (git-ignored) and edit:  cp .env.example .env
# `task ...` loads .env automatically. Running python directly does not: `set -a; . ./.env; set +a`.
# On AWS (Lambda / App Runner) set these as the service's environment variables instead; never
# put real secrets in this file or commit .env.
#
# Precedence: your shell > the local-dev settings in the Taskfile's top-level `env:` (DynamoDB
# Local endpoint and fake credentials, PORT, ON_DEMAND, DATA_DIR) > .env. So .env is for the knobs
# the Taskfile leaves open (limits, hosts, Bedrock, AWS_PROFILE...).

# --------------------------------------------------------------------------- server
HOST=127.0.0.1                 # 0.0.0.0 inside a container / to accept remote connections
PORT=8000
# Hostnames the server accepts besides localhost (DNS-rebinding protection). Comma-separated.
# Needed behind a tunnel or cloud URL, e.g. abc-123.trycloudflare.com,my-fn.lambda-url.us-east-1.on.aws
ALLOWED_HOSTS=

# --------------------------------------------------------------------------- storage
# DynamoDB only (no file / other backends). Local: DynamoDB Local in Docker via `task db:up`.
DATA_DIR=data                  # only the pipeline's download / LLM caches, never the digests
DYNAMODB_TABLE_PREFIX=youcantrememberme-
# Production: leave EMPTY so boto3 talks to real DynamoDB. Local: http://localhost:8001
# (the Taskfile already sets the local value; your shell and this file only matter to change it)
DYNAMODB_ENDPOINT_URL=

# --------------------------------------------------------------------------- AWS (Bedrock, real DynamoDB)
# The region where Bedrock model access is enabled. DynamoDB Local never sees these credentials.
AWS_REGION=us-east-1
# Quickest way to test Bedrock (the web demo's agent, the llm-mode worker): a Bedrock API key,
# created in the Bedrock console. No secret key, profile or IAM setup. For testing only. Set this
# OR the AWS credentials below, not both.
# AWS_BEARER_TOKEN_BEDROCK=<your key>   # uncomment and fill in; leaving it set but empty breaks auth
# Otherwise: on AWS use the function/instance role (set nothing); locally a profile ...
# AWS_PROFILE=my-profile
# ... or keys (add AWS_SESSION_TOKEN for temporary credentials; also needed for real DynamoDB):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --------------------------------------------------------------------------- on-demand shows
ON_DEMAND=1                    # queue unknown shows / stale ranges for the worker (1 = on)
ON_DEMAND_DAILY_LIMIT=20       # new jobs per UTC day (the server has no notion of users)
REFRESH_COOLDOWN_HOURS=24      # min gap between re-fetches of the same show

# --------------------------------------------------------------------------- recap generation
# Used by the worker / `task pipeline:llm` when WORKER_MODE=llm (Claude on Bedrock).
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_EFFORT=low

# --------------------------------------------------------------------------- web demo only
MCP_URL=http://127.0.0.1:8000/mcp
# Which model plays Alexa+ in the web demo. Leave WEB_DEMO_LLM unset to pick automatically from the
# credentials present (OPENAI_* > ANTHROPIC_API_KEY > Bedrock > rules). Values:
#   openai     any OpenAI-compatible API with tool calling: OpenRouter, OpenAI, or a local Ollama
#   anthropic  the Anthropic API directly (ANTHROPIC_API_KEY)
#   bedrock    Claude on Amazon Bedrock (AWS_BEARER_TOKEN_BEDROCK above)
#   rules      no model, offline regex parser (fixed phrasings only)
# WEB_DEMO_LLM=openai

# openai via OpenRouter (https://openrouter.ai/keys; free models exist, pick one with tool support):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=<your OpenRouter key>
# WEB_DEMO_MODEL_ID=google/gemma-4-31b-it:free     # or anthropic/claude-haiku-5.5 (cheap, reliable)
# openai via a local Ollama (free, no key; `ollama pull llama3.1`):
# OPENAI_BASE_URL=http://localhost:11434/v1
# WEB_DEMO_MODEL_ID=llama3.1
# anthropic:
# ANTHROPIC_API_KEY=            # model default claude-sonnet-5-5, override with WEB_DEMO_MODEL_ID
# bedrock: model id e.g. anthropic.claude-sonnet-5 (must be enabled for your account)
